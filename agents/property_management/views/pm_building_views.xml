<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pm_building_view_list" model="ir.ui.view">
        <field name="name">pm.building.list</field>
        <field name="model">pm.building</field>
        <field name="arch" type="xml">
            <tree string="Buildings" delete="false">
                <field name="name"/>
                <field name="address"/>
                <field name="owner_id"/>
                <field name="grace_days"/>
            </tree>
        </field>
    </record>

    <record id="pm_building_view_form" model="ir.ui.view">
        <field name="name">pm.building.form</field>
        <field name="model">pm.building</field>
        <field name="arch" type="xml">
            <form string="Building" delete="false">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Sunrise Apartments"/></h1>
                    </div>
                    <group>
                        <group string="Where and who">
                            <field name="address"/>
                            <field name="owner_id"/>
                        </group>
                        <group string="Water">
                            <field name="uses_ncwsc"/>
                            <field name="uses_borehole"/>
                            <field name="water_category_id" options="{'no_create': True}"/>
                            <field name="leak_threshold_pct"/>
                        </group>
                    </group>
                    <group string="Rules (safe defaults, change only if you need to)">
                        <group>
                            <field name="grace_days"/>
                            <field name="invoice_lead_days"/>
                            <field name="prorate_first_month"/>
                        </group>
                        <group>
                            <field name="deposit_refund_days"/>
                            <field name="approval_threshold"/>
                            <field name="max_photo_mb"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Service charges" groups="property_management.group_pm_manager,property_management.group_pm_accountant,property_management.group_pm_caretaker">
                            <group string="Generator plan">
                                <field name="generator_product_id" options="{'no_create': True}" placeholder="Shared Generator plan"/>
                                <field name="generator_price"/>
                                <field name="generator_count"/>
                            </group>
                            <p class="text-muted">
                                Tenants switch the generator plan on or off themselves in their portal. Each month it is added to their service charge invoice at the price shown above.
                            </p>
                            <separator string="Tenants and the generator plan" groups="property_management.group_pm_manager,property_management.group_pm_accountant"/>
                            <field name="generator_ids" nolabel="1" groups="property_management.group_pm_manager,property_management.group_pm_accountant" context="{'default_building_id': id}">
                                <tree editable="bottom" delete="false">
                                    <field name="lease_id" options="{'no_create': True}" domain="[('building_id', '=', parent.id), ('state', 'in', ('active', 'notice'))]"/>
                                    <field name="tenant_id"/>
                                    <field name="on_plan" widget="boolean_toggle"/>
                                    <field name="status" widget="badge" decoration-success="status == 'paid'" decoration-warning="status in ('unpaid', 'not_invoiced')" decoration-muted="status == 'off'"/>
                                    <field name="product_id" column_invisible="1"/>
                                </tree>
                            </field>
                            <separator string="Fixed monthly charges by unit type"/>
                            <p class="text-muted">
                                These are added to every service charge invoice for the unit type. To change an amount or add an item, open the unit type.
                            </p>
                            <field name="charge_line_ids" nolabel="1" readonly="1">
                                <tree create="false" delete="false" edit="false">
                                    <field name="unit_type_id"/>
                                    <field name="product_id"/>
                                    <field name="amount"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Payment methods">
                            <field name="provider_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="type"/>
                                    <field name="name"/>
                                    <field name="details"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Help contacts">
                            <field name="help_contact_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="label"/>
                                    <field name="phone"/>
                                    <field name="hours"/>
                                    <field name="when_to_call"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="pm_building_action" model="ir.actions.act_window">
        <field name="name">Buildings</field>
        <field name="res_model">pm.building</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No buildings yet. Click <b>New</b> to add your first building.</p>
        </field>
    </record>
</odoo>
