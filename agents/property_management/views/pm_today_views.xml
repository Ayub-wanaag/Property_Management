<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pm_today_view_form" model="ir.ui.view">
        <field name="name">pm.today.form</field>
        <field name="model">pm.today</field>
        <field name="arch" type="xml">
            <form string="Today's overview" create="false" edit="false" delete="false">
                <header>
                    <button name="action_refresh" type="object" string="Refresh"/>
                </header>
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <h1 class="mb-4">Today's overview</h1>
                    <div class="row g-3">

                        <div class="col-12 col-md-6 col-lg-4" groups="property_management.group_pm_accountant">
                            <div class="card h-100"><div class="card-body">
                                <h3 class="h6 text-muted">Payments to check</h3>
                                <div invisible="payments_count == 0">
                                    <div class="display-5 fw-bold"><field name="payments_count"/></div>
                                    <button name="action_open_payments" type="object" string="Open" class="btn btn-primary mt-2"/>
                                </div>
                                <div invisible="payments_count != 0" class="text-success fs-5"><i class="fa fa-check"/> All clear</div>
                            </div></div>
                        </div>

                        <div class="col-12 col-md-6 col-lg-4" groups="property_management.group_pm_manager">
                            <div class="card h-100"><div class="card-body">
                                <h3 class="h6 text-muted">Late-payment requests</h3>
                                <div invisible="late_requests_count == 0">
                                    <div class="display-5 fw-bold"><field name="late_requests_count"/></div>
                                    <button name="action_open_late_requests" type="object" string="Open" class="btn btn-primary mt-2"/>
                                </div>
                                <div invisible="late_requests_count != 0" class="text-success fs-5"><i class="fa fa-check"/> All clear</div>
                            </div></div>
                        </div>

                        <div class="col-12 col-md-6 col-lg-4" groups="property_management.group_pm_caretaker">
                            <div class="card h-100"><div class="card-body">
                                <h3 class="h6 text-muted">Unpaid, in the grace period (chase list)</h3>
                                <div invisible="grace_count == 0">
                                    <div class="display-5 fw-bold"><field name="grace_count"/></div>
                                    <button name="action_open_grace" type="object" string="Open" class="btn btn-primary mt-2"/>
                                </div>
                                <div invisible="grace_count != 0" class="text-success fs-5"><i class="fa fa-check"/> All clear</div>
                            </div></div>
                        </div>

                        <div class="col-12 col-md-6 col-lg-4" groups="property_management.group_pm_accountant">
                            <div class="card h-100"><div class="card-body">
                                <h3 class="h6 text-muted">In arrears</h3>
                                <div invisible="arrears_count == 0">
                                    <div class="display-5 fw-bold text-danger"><field name="arrears_count"/></div>
                                    <button name="action_open_arrears" type="object" string="Open" class="btn btn-primary mt-2"/>
                                </div>
                                <div invisible="arrears_count != 0" class="text-success fs-5"><i class="fa fa-check"/> All clear</div>
                            </div></div>
                        </div>

                        <div class="col-12 col-md-6 col-lg-4" groups="property_management.group_pm_manager">
                            <div class="card h-100"><div class="card-body">
                                <h3 class="h6 text-muted">Vacant units</h3>
                                <div invisible="vacant_count == 0">
                                    <div class="display-5 fw-bold"><field name="vacant_count"/></div>
                                    <button name="action_open_vacant" type="object" string="Open" class="btn btn-primary mt-2"/>
                                </div>
                                <div invisible="vacant_count != 0" class="text-success fs-5"><i class="fa fa-check"/> All clear. Everything is let.</div>
                            </div></div>
                        </div>

                        <div class="col-12 col-md-6 col-lg-4" groups="property_management.group_pm_owner">
                            <div class="card h-100"><div class="card-body">
                                <h3 class="h6 text-muted">Occupied units</h3>
                                <div class="display-5 fw-bold"><field name="occupied_count"/> of <field name="unit_count"/></div>
                                <button name="action_open_units" type="object" string="Open" class="btn btn-primary mt-2"/>
                            </div></div>
                        </div>

                        <div class="col-12 col-md-6 col-lg-4" groups="property_management.group_pm_owner">
                            <div class="card h-100"><div class="card-body">
                                <h3 class="h6 text-muted">Collected this month</h3>
                                <div class="display-5 fw-bold"><field name="collected_month"/></div>
                            </div></div>
                        </div>

                        <div class="col-12 col-md-6 col-lg-4" groups="property_management.group_pm_owner">
                            <div class="card h-100"><div class="card-body">
                                <h3 class="h6 text-muted">In arrears (your buildings)</h3>
                                <div invisible="owner_arrears_count == 0" class="display-5 fw-bold text-danger"><field name="owner_arrears_count"/></div>
                                <div invisible="owner_arrears_count != 0" class="text-success fs-5"><i class="fa fa-check"/> All clear</div>
                            </div></div>
                        </div>

                        <div class="col-12 col-md-6 col-lg-4" groups="property_management.group_pm_caretaker">
                            <div class="card h-100"><div class="card-body">
                                <h3 class="h6 text-muted">Meter readings missing this month</h3>
                                <div invisible="readings_missing_count == 0">
                                    <div class="display-5 fw-bold "><field name="readings_missing_count"/></div>
                                    <button name="action_open_readings_missing" type="object" string="Open" class="btn btn-primary mt-2"/>
                                </div>
                                <div invisible="readings_missing_count != 0" class="text-success fs-5"><i class="fa fa-check"/> All clear</div>
                            </div></div>
                        </div>

                        <div class="col-12 col-md-6 col-lg-4" groups="property_management.group_pm_manager">
                            <div class="card h-100"><div class="card-body">
                                <h3 class="h6 text-muted">Meters missed twice in a row</h3>
                                <div invisible="missed_twice_count == 0">
                                    <div class="display-5 fw-bold text-danger"><field name="missed_twice_count"/></div>
                                    <button name="action_open_missed_twice" type="object" string="Open" class="btn btn-primary mt-2"/>
                                </div>
                                <div invisible="missed_twice_count != 0" class="text-success fs-5"><i class="fa fa-check"/> All clear</div>
                            </div></div>
                        </div>

                        <div class="col-12 col-md-6 col-lg-4" groups="property_management.group_pm_manager">
                            <div class="card h-100"><div class="card-body">
                                <h3 class="h6 text-muted">Water lost above the limit</h3>
                                <div invisible="leak_count == 0">
                                    <div class="display-5 fw-bold text-danger"><field name="leak_count"/></div>
                                    <button name="action_open_leaks" type="object" string="Open" class="btn btn-primary mt-2"/>
                                </div>
                                <div invisible="leak_count != 0" class="text-success fs-5"><i class="fa fa-check"/> All clear</div>
                            </div></div>
                        </div>

                        <div class="col-12 col-md-6 col-lg-4" groups="property_management.group_pm_manager">
                            <div class="card h-100"><div class="card-body">
                                <h3 class="h6 text-muted">Repairs waiting for approval</h3>
                                <div invisible="approvals_count == 0">
                                    <div class="display-5 fw-bold "><field name="approvals_count"/></div>
                                    <button name="action_open_approvals" type="object" string="Open" class="btn btn-primary mt-2"/>
                                </div>
                                <div invisible="approvals_count != 0" class="text-success fs-5"><i class="fa fa-check"/> All clear</div>
                            </div></div>
                        </div>

                        <div class="col-12 col-md-6 col-lg-4" groups="property_management.group_pm_manager">
                            <div class="card h-100"><div class="card-body">
                                <h3 class="h6 text-muted">Urgent problems</h3>
                                <div invisible="urgent_count == 0">
                                    <div class="display-5 fw-bold text-danger"><field name="urgent_count"/></div>
                                    <button name="action_open_urgent" type="object" string="Open" class="btn btn-primary mt-2"/>
                                </div>
                                <div invisible="urgent_count != 0" class="text-success fs-5"><i class="fa fa-check"/> All clear</div>
                            </div></div>
                        </div>

                        <div class="col-12 col-md-6 col-lg-4" groups="property_management.group_pm_manager">
                            <div class="card h-100"><div class="card-body">
                                <h3 class="h6 text-muted">Move-outs waiting</h3>
                                <div invisible="moveouts_count == 0">
                                    <div class="display-5 fw-bold "><field name="moveouts_count"/></div>
                                    <button name="action_open_moveouts" type="object" string="Open" class="btn btn-primary mt-2"/>
                                </div>
                                <div invisible="moveouts_count != 0" class="text-success fs-5"><i class="fa fa-check"/> All clear</div>
                            </div></div>
                        </div>

                        <div class="col-12 col-md-6 col-lg-4" groups="property_management.group_pm_caretaker">
                            <div class="card h-100"><div class="card-body">
                                <h3 class="h6 text-muted">Problems assigned to me</h3>
                                <div invisible="my_tickets_count == 0">
                                    <div class="display-5 fw-bold "><field name="my_tickets_count"/></div>
                                    <button name="action_open_my_tickets" type="object" string="Open" class="btn btn-primary mt-2"/>
                                </div>
                                <div invisible="my_tickets_count != 0" class="text-success fs-5"><i class="fa fa-check"/> All clear</div>
                            </div></div>
                        </div>

                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pm_today_open_server_action" model="ir.actions.server">
        <field name="name">Today</field>
        <field name="model_id" ref="model_pm_today"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_today()</field>
    </record>
</odoo>
