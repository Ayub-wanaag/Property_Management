<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pm_unit_type_view_list" model="ir.ui.view">
        <field name="name">pm.unit.type.list</field>
        <field name="model">pm.unit.type</field>
        <field name="arch" type="xml">
            <tree string="Unit types" delete="false">
                <field name="name"/>
                <field name="default_rent"/>
                <field name="unit_count"/>
            </tree>
        </field>
    </record>

    <record id="pm_unit_type_view_form" model="ir.ui.view">
        <field name="name">pm.unit.type.form</field>
        <field name="model">pm.unit.type</field>
        <field name="arch" type="xml">
            <form string="Unit type" delete="false">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. 2 bedroom"/></h1>
                    </div>
                    <group>
                        <group string="Rent">
                            <field name="default_rent"/>
                            <field name="product_id"/>
                        </group>
                        <group string="Units of this type">
                            <field name="unit_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Service charge items">
                            <p class="text-muted">The fixed part of the service charge for this type of unit, per month.</p>
                            <field name="charge_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="amount" sum="Total per month"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Rooms">
                            <p class="text-muted">The rooms photographed at move-in and move-out. Every room needs at least one photo.</p>
                            <field name="room_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="pm_unit_type_action" model="ir.actions.act_window">
        <field name="name">Unit types</field>
        <field name="res_model">pm.unit.type</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No unit types yet. Click <b>New</b> to add one, like Bedsitter or 2 bedroom, with its rent.</p>
        </field>
    </record>
</odoo>
