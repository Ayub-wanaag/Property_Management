<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reusable: the "call now" box. Urgent problems must be phoned in. -->
    <template id="tenant_call_now_box" name="Call now box">
        <div class="alert alert-danger" role="alert">
            <h2 class="h5 mb-2"><i class="fa fa-phone"/> Burst pipe, power fault or break-in? Call now.</h2>
            <p class="mb-2">Do not wait for a message. Phone the right person straight away.</p>
            <div t-foreach="contacts" t-as="contact" class="mb-2">
                <strong t-out="contact.label"/>:
                <a t-attf-href="tel:#{contact.phone}" class="fw-bold fs-5" t-out="contact.phone"/>
                <span t-if="contact.when_to_call" class="d-block text-muted small" t-out="contact.when_to_call"/>
            </div>
            <p t-if="not contacts" class="mb-0">Ask the caretaker for the emergency number.</p>
        </div>
    </template>

    <!-- ===== Help and contacts ===== -->
    <template id="tenant_help_page" name="Tenant help and contacts">
        <t t-call="portal.portal_layout">
            <t t-set="no_breadcrumbs" t-value="1"/>
            <t t-set="additional_title">Help and contacts</t>
            <div class="container py-4 pm-portal">
                <h1 class="h3 mb-3">Help and contacts</h1>
                <t t-call="property_management.tenant_call_now_box"/>
                <div class="card mb-3">
                    <div class="card-body">
                        <h2 class="h5">Who to call</h2>
                        <div t-foreach="contacts" t-as="contact" class="mb-3">
                            <strong t-out="contact.label"/><br/>
                            <a t-attf-href="tel:#{contact.phone}" t-out="contact.phone"/>
                            <span t-if="contact.hours"> &#183; <t t-out="contact.hours"/></span>
                            <span t-if="contact.when_to_call" class="d-block text-muted" t-out="contact.when_to_call"/>
                        </div>
                        <p t-if="not contacts" class="text-muted mb-0">No contacts added yet. Please ask the office.</p>
                    </div>
                </div>
                <a href="/my/tenant" class="btn btn-outline-secondary btn-lg w-100">Back to my house</a>
            </div>
        </t>
    </template>

    <!-- ===== Problems ===== -->
    <template id="tenant_problems_page" name="Tenant problems">
        <t t-call="portal.portal_layout">
            <t t-set="no_breadcrumbs" t-value="1"/>
            <t t-set="additional_title">Problems</t>
            <div class="container py-4 pm-portal">
                <h1 class="h3 mb-3">Problems in my house</h1>
                <div t-if="done == 'urgent'" class="alert alert-warning">
                    We saved it as urgent. <strong>Please also phone now</strong>: see the numbers below.
                </div>
                <div t-elif="done" class="alert alert-success">Thank you. We received your report.</div>
                <t t-call="property_management.tenant_call_now_box"/>
                <a href="/my/tenant/problems/new" class="btn btn-lg w-100 mb-3 pm-btn-primary">Report a problem</a>
                <div class="card mb-3">
                    <div class="card-body">
                        <h2 class="h5">My reports</h2>
                        <p t-if="not tickets" class="text-muted mb-0">No reports yet. If something is broken, press <b>Report a problem</b>.</p>
                        <div t-foreach="tickets" t-as="ticket" class="mb-3">
                            <a t-attf-href="/my/tenant/problems/#{ticket.id}" class="fw-bold" t-out="ticket.name"/><br/>
                            <span t-attf-class="badge #{badges[ticket.state][1]}" t-out="badges[ticket.state][0]"/>
                            <span t-if="ticket.priority == 'urgent'" class="badge text-bg-danger">Urgent</span>
                        </div>
                    </div>
                </div>
                <a href="/my/tenant" class="btn btn-outline-secondary btn-lg w-100">Back to my house</a>
            </div>
        </t>
    </template>

    <template id="tenant_problem_new_page" name="Report a problem">
        <t t-call="portal.portal_layout">
            <t t-set="no_breadcrumbs" t-value="1"/>
            <t t-set="additional_title">Report a problem</t>
            <div class="container py-4 pm-portal">
                <h1 class="h3 mb-3">Report a problem</h1>
                <t t-call="property_management.tenant_call_now_box"/>
                <div t-if="error" class="alert alert-danger" t-out="error"/>
                <form method="post" action="/my/tenant/problems/new" enctype="multipart/form-data" class="pm-photo-form">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="mb-3">
                        <label class="form-label fs-5" for="name">What is wrong?</label>
                        <input type="text" class="form-control form-control-lg" id="name" name="name" required="required"
                               placeholder="e.g. Kitchen tap is leaking" t-att-value="post.get('name')"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fs-5" for="priority">How urgent is it?</label>
                        <select class="form-select form-select-lg" id="priority" name="priority">
                            <option value="normal" t-att-selected="post.get('priority') in (None, 'normal')">It can wait a day or two</option>
                            <option value="low" t-att-selected="post.get('priority') == 'low'">Not urgent</option>
                            <option value="urgent" t-att-selected="post.get('priority') == 'urgent'">Urgent: danger or damage now (I will also phone)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fs-5" for="description">More details (optional)</label>
                        <textarea class="form-control" id="description" name="description" rows="4"><t t-out="post.get('description')"/></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fs-5" for="photos">Photos (optional, up to 5)</label>
                        <input type="file" class="form-control form-control-lg" id="photos" name="photos" multiple="multiple" accept="image/*"/>
                        <div class="form-text">Each photo can be up to <t t-out="max_mb"/> MB. They are made smaller on your phone first.</div>
                    </div>
                    <progress class="pm-progress w-100 d-none" max="100" value="0"/>
                    <div class="pm-upload-message mt-2 text-muted"/>
                    <button type="submit" class="btn btn-lg w-100 mt-2 pm-btn-primary">Send report</button>
                </form>
                <a href="/my/tenant/problems" class="btn btn-outline-secondary btn-lg w-100 mt-3">Back</a>
            </div>
        </t>
    </template>

    <template id="tenant_problem_detail_page" name="Problem detail">
        <t t-call="portal.portal_layout">
            <t t-set="no_breadcrumbs" t-value="1"/>
            <t t-set="additional_title">Problem</t>
            <div class="container py-4 pm-portal">
                <h1 class="h3 mb-2" t-out="ticket.name"/>
                <p>
                    <span t-attf-class="badge #{badges[ticket.state][1]}" t-out="badges[ticket.state][0]"/>
                    <span t-if="ticket.priority == 'urgent'" class="badge text-bg-danger">Urgent</span>
                </p>
                <t t-if="ticket.priority == 'urgent' and ticket.state not in ('done', 'closed')">
                    <t t-call="property_management.tenant_call_now_box"/>
                </t>
                <div class="card mb-3">
                    <div class="card-body">
                        <p class="mb-1 text-muted">Reported on <t t-out="ticket.create_date" t-options='{"widget": "date"}'/></p>
                        <p t-if="ticket.description" style="white-space: pre-line;" t-out="ticket.description"/>
                        <p t-if="ticket.state in ('new', 'assigned')" class="mb-0">We have your report and will deal with it.</p>
                        <p t-if="ticket.state == 'waiting_approval'" class="mb-0">The repair needs approval before work starts.</p>
                        <p t-if="ticket.state == 'in_progress'" class="mb-0">Work is under way.</p>
                        <p t-if="ticket.state in ('done', 'closed')" class="mb-0">This is fixed.</p>
                    </div>
                </div>
                <a href="/my/tenant/problems" class="btn btn-outline-secondary btn-lg w-100">Back to my reports</a>
            </div>
        </t>
    </template>

    <!-- ===== Documents ===== -->
    <template id="tenant_documents_page" name="Tenant documents">
        <t t-call="portal.portal_layout">
            <t t-set="no_breadcrumbs" t-value="1"/>
            <t t-set="additional_title">Documents</t>
            <div class="container py-4 pm-portal">
                <h1 class="h3 mb-3">My documents</h1>
                <div class="card mb-3">
                    <div class="card-body">
                        <p t-if="not documents" class="text-muted mb-0">No documents yet. Your lease and other papers will appear here when the office adds them.</p>
                        <div t-foreach="documents" t-as="document" class="mb-3">
                            <strong t-out="document.name"/><br/>
                            <a t-attf-href="/my/tenant/documents/#{document.id}/download" class="btn btn-outline-secondary">Download</a>
                        </div>
                    </div>
                </div>
                <a href="/my/tenant" class="btn btn-outline-secondary btn-lg w-100">Back to my house</a>
            </div>
        </t>
    </template>

    <!-- ===== Move out ===== -->
    <template id="tenant_move_out_page" name="Tenant move out">
        <t t-call="portal.portal_layout">
            <t t-set="no_breadcrumbs" t-value="1"/>
            <t t-set="additional_title">Move out</t>
            <div class="container py-4 pm-portal">
                <h1 class="h3 mb-3">Move out</h1>
                <div t-if="error" class="alert alert-danger" t-out="error"/>
                <div t-if="done == '1'" class="alert alert-success">Thank you. We received your request.</div>
                <div t-if="done == 'photos'" class="alert alert-success">Thank you. We received your photos.</div>
                <div t-if="done == 'dispute'" class="alert alert-success">We received your explanation. The manager will read it and decide.</div>
                <div t-if="done in ('dispute_empty', 'dispute_failed')" class="alert alert-danger">
                    We could not send that. Please write why you disagree and try again.
                </div>

                <t t-if="not move_out">
                    <div class="card mb-3">
                        <div class="card-body">
                            <p>Your lease asks for <strong t-out="lease.notice_days"/> days' notice before you leave.</p>
                            <form method="post" action="/my/tenant/move-out">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="mb-3">
                                    <label class="form-label fs-5" for="requested_date">The day I will move out</label>
                                    <input type="date" class="form-control form-control-lg" id="requested_date" name="requested_date"
                                           required="required" t-att-min="today" t-att-value="post.get('requested_date')"/>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fs-5" for="note">Anything we should know (optional)</label>
                                    <textarea class="form-control" id="note" name="note" rows="3"><t t-out="post.get('note')"/></textarea>
                                </div>
                                <button type="submit" class="btn btn-lg w-100 pm-btn-primary">Ask to move out</button>
                            </form>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <div class="card mb-3">
                        <div class="card-body">
                            <p class="mb-1">Moving out on <strong t-out="move_out.requested_date" t-options='{"widget": "date"}'/></p>
                            <p class="mb-2" t-out="steps[move_out.state]"/>
                            <a t-if="move_out.state == 'acknowledged'" href="/my/tenant/move-out/photos"
                               class="btn btn-lg w-100 pm-btn-primary">Upload photos of every room</a>
                        </div>
                    </div>
                </t>

                <t t-if="deposit and deposit.state in ('refund_pending', 'disputed', 'refunded')">
                    <div class="card mb-3">
                        <div class="card-body">
                            <h2 class="h5">Your deposit</h2>
                            <div class="d-flex justify-content-between"><span>Deposit paid</span>
                                <strong t-out="deposit.amount" t-options='{"widget": "float", "precision": 2}'/></div>
                            <div t-foreach="deposit.deduction_ids" t-as="line" class="d-flex justify-content-between text-muted">
                                <span t-out="line.description"/>
                                <span>- <t t-out="line.amount" t-options='{"widget": "float", "precision": 2}'/></span>
                            </div>
                            <hr/>
                            <div class="d-flex justify-content-between fs-5"><span>To be refunded</span>
                                <strong t-out="deposit.refund_amount" t-options='{"widget": "float", "precision": 2}'/></div>
                            <p t-if="deposit.tenant_owes" class="text-danger mt-2">You still owe <t t-out="deposit.tenant_owes" t-options='{"widget": "float", "precision": 2}'/>.</p>
                            <p t-if="deposit.refund_due_date" class="text-muted mt-2">Refund due by <t t-out="deposit.refund_due_date" t-options='{"widget": "date"}'/>.</p>
                            <span t-if="deposit.state == 'disputed'" class="badge text-bg-warning">You disputed a deduction. Waiting for a decision.</span>
                            <span t-if="deposit.state == 'refunded'" class="badge text-bg-success">Refunded</span>
                            <form t-if="deposit.state == 'refund_pending'" method="post" action="/my/tenant/deposit/dispute" class="mt-3">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <label class="form-label" for="explanation">Do you disagree with a deduction? Write why:</label>
                                <textarea class="form-control mb-2" id="explanation" name="explanation" rows="3" required="required"/>
                                <button type="submit" class="btn btn-outline-secondary">Send my explanation</button>
                            </form>
                        </div>
                    </div>
                </t>
                <a href="/my/tenant" class="btn btn-outline-secondary btn-lg w-100">Back to my house</a>
            </div>
        </t>
    </template>

    <template id="tenant_move_out_photos_page" name="Move-out photos">
        <t t-call="portal.portal_layout">
            <t t-set="no_breadcrumbs" t-value="1"/>
            <t t-set="additional_title">Move-out photos</t>
            <div class="container py-4 pm-portal">
                <h1 class="h3 mb-2">Photos of every room</h1>
                <p class="text-muted">Take at least one photo of each room, so we can check the house together. Each photo can be up to <t t-out="max_mb"/> MB. They are made smaller on your phone first.</p>
                <div t-if="error" class="alert alert-danger" t-out="error"/>
                <form method="post" action="/my/tenant/move-out/photos" enctype="multipart/form-data" class="pm-photo-form">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div t-foreach="rooms" t-as="room" class="mb-3">
                        <label class="form-label fs-5" t-attf-for="room_#{room.id}" t-out="room.name"/>
                        <input type="file" class="form-control form-control-lg" t-attf-id="room_#{room.id}" t-attf-name="room_#{room.id}"
                               multiple="multiple" accept="image/*"/>
                    </div>
                    <progress class="pm-progress w-100 d-none" max="100" value="0"/>
                    <div class="pm-upload-message mt-2 text-muted"/>
                    <button type="submit" class="btn btn-lg w-100 mt-2 pm-btn-primary">Send the photos</button>
                </form>
                <a href="/my/tenant/move-out" class="btn btn-outline-secondary btn-lg w-100 mt-3">Back</a>
            </div>
        </t>
    </template>
</odoo>
