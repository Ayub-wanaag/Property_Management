<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Overdue invoices: caretakers only see the grace period (their chase list). Arrears go to accountants and managers. -->
    <record id="pm_overdue_invoice_rule_caretaker" model="ir.rule">
        <field name="name">Overdue invoice: caretakers see only the grace period</field>
        <field name="model_id" ref="model_pm_overdue_invoice"/>
        <field name="domain_force">[('stage', '=', 'grace')]</field>
        <field name="groups" eval="[(4, ref('pm_property.group_pm_caretaker'))]"/>
    </record>

    <record id="pm_overdue_invoice_rule_accountant" model="ir.rule">
        <field name="name">Overdue invoice: accountants see everything overdue</field>
        <field name="model_id" ref="model_pm_overdue_invoice"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('pm_property.group_pm_accountant'))]"/>
    </record>

    <!-- Receipts: owners see only receipts for their own buildings -->
    <record id="pm_receipt_rule_staff" model="ir.rule">
        <field name="name">Receipt: staff see all receipts</field>
        <field name="model_id" ref="model_pm_receipt"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('pm_property.group_pm_accountant')), (4, ref('pm_property.group_pm_manager'))]"/>
    </record>

    <record id="pm_receipt_rule_owner" model="ir.rule">
        <field name="name">Receipt: owners see only their buildings</field>
        <field name="model_id" ref="model_pm_receipt"/>
        <field name="domain_force">[('building_id.owner_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('pm_property.group_pm_owner'))]"/>
    </record>
</odoo>
