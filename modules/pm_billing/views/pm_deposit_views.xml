<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pm_deposit_view_form_billing" model="ir.ui.view">
        <field name="name">pm.deposit.form.billing</field>
        <field name="model">pm.deposit</field>
        <field name="inherit_id" ref="pm_property.pm_deposit_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_add_unpaid_balances']" position="after">
                <button name="action_add_final_water" type="object" string="Add final water bill"
                        invisible="state not in ('held', 'refund_pending', 'disputed')"/>
            </xpath>
        </field>
    </record>
</odoo>
