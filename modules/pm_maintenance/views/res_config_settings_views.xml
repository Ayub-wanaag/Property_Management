<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_maintenance" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.maintenance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Maintenance" string="Maintenance" name="pm_maintenance">
                    <block title="Repairs" name="pm_maintenance_repairs">
                        <setting string="Ask approval above (KES)" help="Used for new buildings. Existing buildings keep their own value.">
                            <field name="pm_approval_threshold"/>
                        </setting>
                        <setting string="Days to pay a repair charge" help="Applies to repair invoices created from now on.">
                            <field name="pm_repair_charge_days"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
