<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pm_lease_login_wizard_view_form" model="ir.ui.view">
        <field name="name">pm.lease.login.wizard.form</field>
        <field name="model">pm.lease.login.wizard</field>
        <field name="arch" type="xml">
            <form string="Tenant login">
                <field name="state" invisible="1"/>

                <div class="alert alert-warning" role="alert" invisible="state == 'done'">
                    Choose a password for the tenant. If the tenant already has a login, the old password stops working.
                </div>
                <div class="alert alert-success" role="alert" invisible="state != 'done'">
                    The login is ready. Print the welcome sheet now. The password will not be shown again after you close this window.
                </div>

                <group>
                    <field name="tenant_name"/>
                    <field name="house"/>
                    <field name="password" readonly="state == 'done'"/>
                    <field name="login_url" invisible="state != 'done'"/>
                </group>

                <footer>
                    <button name="action_create" type="object" string="Create login" class="btn-primary"
                            invisible="state == 'done'"/>
                    <button name="%(pm_property.action_report_welcome_sheet)d" type="action"
                            string="Print welcome sheet" class="btn-primary" invisible="state != 'done'"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
