<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pm_unit_view_kanban" model="ir.ui.view">
        <field name="name">pm.unit.kanban</field>
        <field name="model">pm.unit</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" group_create="false" group_delete="false" group_edit="false"
                    records_draggable="false" quick_create="false">
                <field name="number"/>
                <field name="status"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex justify-content-between align-items-center">
                                <strong class="fs-4"><field name="number"/></strong>
                                <field name="status" widget="badge"
                                       decoration-success="status == 'occupied'"
                                       decoration-danger="status == 'vacant'"
                                       decoration-warning="status == 'notice_given'"
                                       decoration-info="status == 'renovation'"
                                       decoration-primary="status == 'reserved'"/>
                            </div>
                            <div><field name="unit_type_id"/></div>
                            <div class="text-muted">Floor <field name="floor"/> | KES <field name="rent_amount"/></div>
                            <div class="text-muted"><field name="building_id"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="pm_unit_view_list" model="ir.ui.view">
        <field name="name">pm.unit.list</field>
        <field name="model">pm.unit</field>
        <field name="arch" type="xml">
            <tree string="Units" delete="false">
                <field name="number"/>
                <field name="building_id"/>
                <field name="floor"/>
                <field name="unit_type_id"/>
                <field name="rent_amount"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'occupied'"
                       decoration-danger="status == 'vacant'"
                       decoration-warning="status == 'notice_given'"
                       decoration-info="status == 'renovation'"
                       decoration-primary="status == 'reserved'"/>
            </tree>
        </field>
    </record>

    <record id="pm_unit_view_form" model="ir.ui.view">
        <field name="name">pm.unit.form</field>
        <field name="model">pm.unit</field>
        <field name="arch" type="xml">
            <form string="Unit" delete="false">
                <header>
                    <field name="status" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="number"/>
                        <h1><field name="number" placeholder="e.g. A12"/></h1>
                    </div>
                    <group>
                        <group string="Where">
                            <field name="building_id"/>
                            <field name="floor"/>
                        </group>
                        <group string="Rent">
                            <field name="unit_type_id" domain="[('building_id', 'in', [building_id, False])]"/>
                            <field name="rent_override"/>
                            <field name="rent_amount"/>
                        </group>
                    </group>
                    <group string="Who lives here"
                           groups="pm_property.group_pm_caretaker,pm_property.group_pm_accountant">
                        <field name="current_lease_id"/>
                    </group>
                    <notebook groups="pm_property.group_pm_caretaker,pm_property.group_pm_accountant">
                        <page string="Status history">
                            <field name="status_log_ids" readonly="1">
                                <tree>
                                    <field name="status"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="changed_by"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="pm_unit_view_search" model="ir.ui.view">
        <field name="name">pm.unit.search</field>
        <field name="model">pm.unit</field>
        <field name="arch" type="xml">
            <search string="Search units">
                <field name="number"/>
                <field name="building_id"/>
                <field name="unit_type_id"/>
                <filter name="filter_vacant" string="Vacant" domain="[('status', '=', 'vacant')]"/>
                <filter name="filter_occupied" string="Occupied" domain="[('status', '=', 'occupied')]"/>
                <filter name="filter_notice" string="Notice given" domain="[('status', '=', 'notice_given')]"/>
                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group by">
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_building" string="Building" context="{'group_by': 'building_id'}"/>
                    <filter name="group_floor" string="Floor" context="{'group_by': 'floor'}"/>
                    <filter name="group_type" string="Unit type" context="{'group_by': 'unit_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="pm_unit_action" model="ir.actions.act_window">
        <field name="name">Units</field>
        <field name="res_model">pm.unit</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No units yet. Click <b>New</b> to add your first unit.</p>
        </field>
    </record>
</odoo>
