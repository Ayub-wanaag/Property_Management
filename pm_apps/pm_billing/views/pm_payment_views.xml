<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== Tenant payment claims ===== -->
    <record id="pm_payment_claim_view_list" model="ir.ui.view">
        <field name="name">pm.payment.claim.list</field>
        <field name="model">pm.payment.claim</field>
        <field name="arch" type="xml">
            <tree string="Payment proof" delete="false" create="false">
                <field name="create_date" string="Sent"/>
                <field name="lease_id"/>
                <field name="tenant_id"/>
                <field name="kind"/>
                <field name="amount"/>
                <field name="transaction_code"/>
                <field name="amount_mismatch" invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-success="state == 'verified'"
                       decoration-danger="state == 'rejected'"/>
            </tree>
        </field>
    </record>

    <record id="pm_payment_claim_view_form" model="ir.ui.view">
        <field name="name">pm.payment.claim.form</field>
        <field name="model">pm.payment.claim</field>
        <field name="arch" type="xml">
            <form string="Payment proof" delete="false">
                <header>
                    <button name="action_verify" type="object" string="Check and record payment" class="btn-primary"
                            invisible="state != 'submitted'"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state != 'submitted'"
                            confirm="Reject this claim? The tenant will see your reason."/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not amount_mismatch or state != 'submitted'">
                        The amount in the message is different from the amount the tenant claimed. Check the real statement.
                    </div>
                    <group>
                        <group string="Who">
                            <field name="lease_id"/>
                            <field name="tenant_id"/>
                            <field name="kind"/>
                        </group>
                        <group string="What they say they paid">
                            <field name="amount"/>
                            <field name="method"/>
                            <field name="transaction_code"/>
                            <field name="parsed_amount"/>
                            <field name="amount_mismatch" invisible="1"/>
                        </group>
                    </group>
                    <group string="Proof">
                        <field name="sms_text" placeholder="The M-Pesa message the tenant pasted"/>
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                    <group string="Decision" invisible="state == 'submitted'">
                        <field name="verified_by"/>
                        <field name="verified_on"/>
                        <field name="invoice_id"/>
                        <field name="receipt_id"/>
                    </group>
                    <group string="If you reject it">
                        <field name="rejection_reason" readonly="state != 'submitted'"
                               placeholder="e.g. We could not find this payment on the statement"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="pm_payment_claim_view_search" model="ir.ui.view">
        <field name="name">pm.payment.claim.search</field>
        <field name="model">pm.payment.claim</field>
        <field name="arch" type="xml">
            <search string="Search payment proof">
                <field name="tenant_id"/>
                <field name="lease_id" string="Unit"/>
                <field name="transaction_code"/>
                <filter name="filter_submitted" string="Waiting to be checked" domain="[('state', '=', 'submitted')]"/>
                <filter name="filter_verified" string="Verified" domain="[('state', '=', 'verified')]"/>
                <filter name="filter_rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <group expand="0" string="Group by">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_building" string="Building" context="{'group_by': 'building_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="pm_payment_claim_to_check_action" model="ir.actions.act_window">
        <field name="name">Payments to check</field>
        <field name="res_model">pm.payment.claim</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('state', '=', 'submitted')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">All clear. No payments waiting to be checked.</p>
            <p>When a tenant sends proof of payment from the tenant portal, it appears here.</p>
        </field>
    </record>

    <record id="pm_payment_claim_all_action" model="ir.actions.act_window">
        <field name="name">All payment proof</field>
        <field name="res_model">pm.payment.claim</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="pm_payment_claim_view_search"/>
    </record>

    <!-- ===== Record a payment ===== -->
    <record id="pm_payment_wizard_view_form" model="ir.ui.view">
        <field name="name">pm.payment.wizard.form</field>
        <field name="model">pm.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Record a payment">
                <field name="claim_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <div class="alert alert-warning" role="alert" invisible="not claim_note">
                    <field name="claim_note" nolabel="1"/>
                </div>
                <group>
                    <field name="invoice_id" options="{'no_create': True}"/>
                    <field name="amount_due"/>
                    <field name="amount"/>
                    <field name="method"/>
                    <field name="transaction_code" invisible="method == 'cash'"/>
                    <field name="journal_id" options="{'no_create': True}"/>
                    <field name="checked" invisible="not claim_id"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Record payment and print receipt" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="pm_payment_wizard_action" model="ir.actions.act_window">
        <field name="name">Record a payment</field>
        <field name="res_model">pm.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ===== Receipts ===== -->
    <record id="pm_receipt_view_list" model="ir.ui.view">
        <field name="name">pm.receipt.list</field>
        <field name="model">pm.receipt</field>
        <field name="arch" type="xml">
            <tree string="Receipts" create="false" delete="false">
                <field name="name"/>
                <field name="date"/>
                <field name="tenant_id"/>
                <field name="lease_id"/>
                <field name="invoice_number"/>
                <field name="method"/>
                <field name="amount" sum="Total received"/>
            </tree>
        </field>
    </record>

    <record id="pm_receipt_view_form" model="ir.ui.view">
        <field name="name">pm.receipt.form</field>
        <field name="model">pm.receipt</field>
        <field name="arch" type="xml">
            <form string="Receipt" create="false" edit="false" delete="false">
                <header>
                    <button name="%(pm_billing.action_report_receipt)d" type="action" string="Print receipt" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="tenant_id"/>
                            <field name="lease_id"/>
                        </group>
                        <group>
                            <field name="invoice_number"/>
                            <field name="kind"/>
                            <field name="amount"/>
                            <field name="method"/>
                            <field name="transaction_code"/>
                            <field name="recorded_by"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pm_receipt_action" model="ir.actions.act_window">
        <field name="name">Receipts</field>
        <field name="res_model">pm.receipt</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No receipts yet.</p>
            <p>A receipt is made every time you record a payment.</p>
        </field>
    </record>

    <!-- ===== Late-payment requests ===== -->
    <record id="pm_late_request_view_list" model="ir.ui.view">
        <field name="name">pm.late.request.list</field>
        <field name="model">pm.late.request</field>
        <field name="arch" type="xml">
            <tree string="Late-payment requests" create="false" delete="false">
                <field name="create_date" string="Sent"/>
                <field name="lease_id"/>
                <field name="tenant_id"/>
                <field name="invoice_number"/>
                <field name="current_due_date"/>
                <field name="proposed_date"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'new'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'declined'"/>
            </tree>
        </field>
    </record>

    <record id="pm_late_request_view_form" model="ir.ui.view">
        <field name="name">pm.late.request.form</field>
        <field name="model">pm.late.request</field>
        <field name="arch" type="xml">
            <form string="Late-payment request" create="false" delete="false">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            groups="pm_property.group_pm_manager" invisible="state != 'new'"
                            confirm="Approve? The invoice's due date moves to the date the tenant proposed."/>
                    <button name="action_decline" type="object" string="Decline"
                            groups="pm_property.group_pm_manager" invisible="state != 'new'"
                            confirm="Decline? Nothing changes on the invoice."/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Who">
                            <field name="lease_id"/>
                            <field name="tenant_id"/>
                            <field name="invoice_number"/>
                        </group>
                        <group string="Dates">
                            <field name="current_due_date"/>
                            <field name="proposed_date" readonly="state != 'new'"/>
                            <field name="decided_by"/>
                            <field name="decided_on"/>
                        </group>
                    </group>
                    <group string="Why">
                        <field name="reason" readonly="1" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="pm_late_request_action" model="ir.actions.act_window">
        <field name="name">Late-payment requests</field>
        <field name="res_model">pm.late.request</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('state', '=', 'new')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">All clear. No requests waiting for a decision.</p>
            <p>When a tenant asks for more time, it appears here.</p>
        </field>
    </record>
</odoo>
