<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_billing" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.billing</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Billing" string="Billing" name="pm_billing">
                    <block title="Rent collection (used for new buildings)" name="pm_billing_rent">
                        <setting string="Grace days" help="Existing buildings keep their own value.">
                            <field name="pm_grace_days"/>
                        </setting>
                        <setting string="Invoice days before rent is due" help="Existing buildings keep their own value.">
                            <field name="pm_invoice_lead_days"/>
                        </setting>
                        <setting string="First month rent" help="Existing buildings keep their own value.">
                            <field name="pm_first_month"/>
                        </setting>
                    </block>
                    <block title="Water (used for new buildings)" name="pm_billing_water">
                        <setting string="Water leak warning (%)" help="Existing buildings keep their own value.">
                            <field name="pm_leak_threshold_pct"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
