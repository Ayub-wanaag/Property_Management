<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Problems: caretakers see only the ones assigned to them; managers see all -->
    <record id="pm_ticket_rule_manager" model="ir.rule">
        <field name="name">Problem: managers see all problems</field>
        <field name="model_id" ref="model_pm_ticket"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('pm_property.group_pm_manager'))]"/>
    </record>

    <record id="pm_ticket_rule_caretaker" model="ir.rule">
        <field name="name">Problem: caretakers see the problems assigned to them</field>
        <field name="model_id" ref="model_pm_ticket"/>
        <field name="domain_force">[('assigned_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('pm_property.group_pm_caretaker'))]"/>
    </record>
</odoo>
