<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pm_building_view_form_billing" model="ir.ui.view">
        <field name="name">pm.building.form.billing</field>
        <field name="model">pm.building</field>
        <field name="inherit_id" ref="pm_property.pm_building_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='pm_page_where']" position="after">
                <page string="Water" name="pm_page_water">
                    <group name="pm_water">
                        <field name="uses_ncwsc"/>
                        <field name="uses_borehole"/>
                        <field name="water_category_id" options="{'no_create': True}"/>
                    </group>
                </page>
            </xpath>
            <xpath expr="//group[@name='pm_rules']" position="inside">
                    <field name="grace_days"/>
                    <field name="invoice_lead_days"/>
                    <field name="prorate_first_month"/>
            </xpath>
            <xpath expr="//page[@name='pm_help']" position="before">
                        <page string="Service charges" name="pm_service_charges" groups="pm_property.group_pm_manager,pm_property.group_pm_accountant,pm_property.group_pm_caretaker">
                            <group string="Generator plan">
                                <field name="generator_product_id" options="{'no_create': True}" placeholder="Shared Generator plan"/>
                                <field name="generator_price"/>
                                <field name="generator_count"/>
                            </group>
                            <p class="text-muted">
                                Tenants switch the generator plan on or off themselves in their portal. Each month it is added to their service charge invoice at the price shown above.
                            </p>
                            <separator string="Tenants and the generator plan" groups="pm_property.group_pm_manager,pm_property.group_pm_accountant"/>
                            <field name="generator_ids" nolabel="1" groups="pm_property.group_pm_manager,pm_property.group_pm_accountant" context="{'default_building_id': id}">
                                <tree editable="bottom" delete="false">
                                    <field name="lease_id" options="{'no_create': True}" domain="[('building_id', '=', parent.id), ('state', 'in', ('active', 'notice'))]"/>
                                    <field name="tenant_id"/>
                                    <field name="on_plan" widget="boolean_toggle"/>
                                    <field name="status" widget="badge" decoration-success="status == 'paid'" decoration-warning="status in ('unpaid', 'not_invoiced')" decoration-muted="status == 'off'"/>
                                    <field name="product_id" column_invisible="1"/>
                                </tree>
                            </field>
                            <separator string="Fixed monthly charges by unit type"/>
                            <p class="text-muted">
                                These are added to every service charge invoice for the unit type. To change an amount or add an item, open the unit type.
                            </p>
                            <field name="charge_line_ids" nolabel="1" readonly="1">
                                <tree create="false" delete="false" edit="false">
                                    <field name="unit_type_id"/>
                                    <field name="product_id"/>
                                    <field name="amount"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Payment methods" name="pm_payment_methods">
                            <field name="provider_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="type"/>
                                    <field name="name"/>
                                    <field name="details"/>
                                </tree>
                            </field>
                        </page>
            </xpath>
        </field>
    </record>

    <record id="pm_building_view_list_billing" model="ir.ui.view">
        <field name="name">pm.building.list.billing</field>
        <field name="model">pm.building</field>
        <field name="inherit_id" ref="pm_property.pm_building_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='owner_id']" position="after">
                <field name="grace_days"/>
            </xpath>
        </field>
    </record>
</odoo>
