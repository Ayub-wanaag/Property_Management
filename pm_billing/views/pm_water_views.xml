<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== Meters ===== -->
    <record id="pm_meter_view_list" model="ir.ui.view">
        <field name="name">pm.meter.list</field>
        <field name="model">pm.meter</field>
        <field name="arch" type="xml">
            <tree string="Meters" delete="false" decoration-muted="state == 'replaced'">
                <field name="unit_id"/>
                <field name="serial"/>
                <field name="start_reading"/>
                <field name="start_date"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-muted="state == 'replaced'"/>
            </tree>
        </field>
    </record>

    <record id="pm_meter_view_form" model="ir.ui.view">
        <field name="name">pm.meter.form</field>
        <field name="model">pm.meter</field>
        <field name="arch" type="xml">
            <form string="Meter" delete="false">
                <header>
                    <button name="action_replace" type="object" string="Replace meter" invisible="state != 'active'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="unit_id" options="{'no_create': True}" readonly="state == 'replaced'"/>
                            <field name="serial"/>
                        </group>
                        <group>
                            <field name="start_reading"/>
                            <field name="start_date"/>
                            <field name="end_date" invisible="state != 'replaced'"/>
                            <field name="final_reading" invisible="state != 'replaced'"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="pm_meter_action" model="ir.actions.act_window">
        <field name="name">Meters</field>
        <field name="res_model">pm.meter</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No meters yet.</p>
            <p>Click <b>New</b> to add the water meter of a unit. Type the number printed on the meter.</p>
        </field>
    </record>

    <record id="pm_meter_swap_wizard_view_form" model="ir.ui.view">
        <field name="name">pm.meter.swap.wizard.form</field>
        <field name="model">pm.meter.swap.wizard</field>
        <field name="arch" type="xml">
            <form string="Replace meter">
                <group>
                    <group string="Old meter">
                        <field name="meter_id" invisible="1"/>
                        <field name="unit_id"/>
                        <field name="current_serial"/>
                        <field name="last_reading"/>
                        <field name="final_reading"/>
                    </group>
                    <group string="New meter">
                        <field name="new_serial" required="1"/>
                        <field name="new_start_reading"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Replace meter" class="btn-primary"
                            confirm="The old meter will be closed with the reading you typed. Continue?"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ===== Readings ===== -->
    <record id="pm_meter_reading_view_list" model="ir.ui.view">
        <field name="name">pm.meter.reading.list</field>
        <field name="model">pm.meter.reading</field>
        <field name="arch" type="xml">
            <tree string="Readings" create="false" delete="false" decoration-warning="kind == 'estimated'">
                <field name="date"/>
                <field name="unit_id"/>
                <field name="meter_id"/>
                <field name="previous"/>
                <field name="current"/>
                <field name="units"/>
                <field name="kind" widget="badge" decoration-info="kind == 'actual'" decoration-warning="kind == 'estimated'" decoration-muted="kind == 'final'"/>
                <field name="billed" widget="boolean" string="On an invoice"/>
            </tree>
        </field>
    </record>

    <record id="pm_meter_reading_view_form" model="ir.ui.view">
        <field name="name">pm.meter.reading.form</field>
        <field name="model">pm.meter.reading</field>
        <field name="arch" type="xml">
            <form string="Reading" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="meter_id" options="{'no_create': True}"/>
                            <field name="date"/>
                            <field name="kind"/>
                            <field name="current"/>
                        </group>
                        <group>
                            <field name="previous"/>
                            <field name="units"/>
                            <field name="warning" invisible="not warning" class="text-warning"/>
                            <field name="billed" widget="boolean"/>
                            <field name="entered_by"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Note"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pm_meter_reading_view_search" model="ir.ui.view">
        <field name="name">pm.meter.reading.search</field>
        <field name="model">pm.meter.reading</field>
        <field name="arch" type="xml">
            <search>
                <field name="unit_id"/>
                <field name="meter_id"/>
                <filter name="estimated" string="Estimated" domain="[('kind', '=', 'estimated')]"/>
                <filter name="not_billed" string="Not on an invoice yet" domain="[('billed', '=', False)]"/>
                <group expand="0" string="Group by">
                    <filter name="by_month" string="Month" context="{'group_by': 'month'}"/>
                    <filter name="by_unit" string="Unit" context="{'group_by': 'unit_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="pm_meter_reading_action" model="ir.actions.act_window">
        <field name="name">Readings</field>
        <field name="res_model">pm.meter.reading</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No readings yet.</p>
            <p>Open <b>Enter meter readings</b> to type this month's numbers for every unit.</p>
        </field>
    </record>

    <!-- ===== The monthly readings sheet ===== -->
    <record id="pm_reading_sheet_view_form" model="ir.ui.view">
        <field name="name">pm.reading.sheet.form</field>
        <field name="model">pm.reading.sheet</field>
        <field name="arch" type="xml">
            <form string="Enter meter readings">
                <header>
                    <button name="action_save" type="object" string="Save readings" class="btn-primary"/>
                    <button name="action_estimate_missing" type="object" string="Save, and estimate the ones left empty"
                            confirm="Units left empty get an estimate from their last 3 real readings, marked 'estimated'. It is corrected at the next real reading. Continue?"/>
                </header>
                <sheet>
                    <h1>Enter meter readings</h1>
                    <group>
                        <field name="building_id" options="{'no_create': True}"/>
                        <field name="date"/>
                    </group>
                    <p class="text-muted">
                        Type the number on each meter. Leave empty any meter you could not read. A unit with no meter yet: type its meter number and the number it shows now. That number becomes its starting number. Odd numbers are marked, but you can still save them.
                    </p>
                    <field name="line_ids" nolabel="1">
                        <tree editable="bottom" create="false" delete="false"
                              decoration-danger="current &gt; 0 and current &lt; previous"
                              decoration-warning="warning and current &gt;= previous">
                            <field name="meter_id" column_invisible="1" force_save="1"/>
                            <field name="unit_id" force_save="1"/>
                            <field name="serial" readonly="meter_id"/>
                            <field name="previous"/>
                            <field name="current"/>
                            <field name="units"/>
                            <field name="warning"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pm_reading_sheet_action" model="ir.actions.act_window">
        <field name="name">Enter meter readings</field>
        <field name="res_model">pm.reading.sheet</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <!-- ===== Water costs for the month ===== -->
    <record id="pm_water_cycle_view_list" model="ir.ui.view">
        <field name="name">pm.water.cycle.list</field>
        <field name="model">pm.water.cycle</field>
        <field name="arch" type="xml">
            <tree string="Water costs" delete="false">
                <field name="building_id"/>
                <field name="month"/>
                <field name="total_cost"/>
                <field name="rate"/>
                <field name="loss_percent"/>
                <field name="invoiced" widget="boolean"/>
            </tree>
        </field>
    </record>

    <record id="pm_water_cycle_view_form" model="ir.ui.view">
        <field name="name">pm.water.cycle.form</field>
        <field name="model">pm.water.cycle</field>
        <field name="arch" type="xml">
            <form string="Water costs" delete="false">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_readings" type="object" class="oe_stat_button" icon="fa-tachometer" string="Readings"/>
                    </div>
                    <field name="uses_ncwsc" invisible="1"/>
                    <field name="uses_borehole" invisible="1"/>
                    <group>
                        <group string="What the water cost">
                            <field name="building_id" options="{'no_create': True}"/>
                            <field name="month"/>
                            <field name="ncwsc_cost" invisible="not uses_ncwsc"/>
                            <field name="borehole_cost" invisible="not uses_borehole"/>
                            <field name="main_meter_units"/>
                        </group>
                        <group string="Rate for the month">
                            <field name="total_cost"/>
                            <field name="billed_units"/>
                            <field name="drawn_units"/>
                            <field name="rate" class="fw-bold"/>
                            <field name="invoiced" widget="boolean"/>
                        </group>
                    </group>
                    <group string="Water lost between the main meter and the units">
                        <group>
                            <field name="loss_units"/>
                            <field name="loss_percent"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="pm_water_cycle_action" model="ir.actions.act_window">
        <field name="name">Water costs</field>
        <field name="res_model">pm.water.cycle</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No water costs yet.</p>
            <p>Click <b>New</b>, pick the month and type what the water cost. The rate per unit is worked out for you.</p>
        </field>
    </record>

    <!-- ===== Generator plan ===== -->
    <record id="pm_generator_view_list" model="ir.ui.view">
        <field name="name">pm.generator.subscription.list</field>
        <field name="model">pm.generator.subscription</field>
        <field name="arch" type="xml">
            <tree string="Generator plan" delete="false">
                <field name="unit_id"/>
                <field name="tenant_id"/>
                <field name="on_plan" widget="boolean_toggle"/>
                <field name="price"/>
                <field name="period_end"/>
                <field name="status" widget="badge" decoration-success="status == 'paid'" decoration-warning="status in ('unpaid', 'not_invoiced')" decoration-muted="status == 'off'"/>
            </tree>
        </field>
    </record>

    <record id="pm_generator_view_form" model="ir.ui.view">
        <field name="name">pm.generator.subscription.form</field>
        <field name="model">pm.generator.subscription</field>
        <field name="arch" type="xml">
            <form string="Generator plan" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="lease_id" options="{'no_create': True}"/>
                            <field name="tenant_id"/>
                            <field name="on_plan"/>
                            <field name="product_id" options="{'no_create': True}"/>
                            <field name="price"/>
                        </group>
                        <group>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="status" widget="badge" decoration-success="status == 'paid'" decoration-warning="status in ('unpaid', 'not_invoiced')" decoration-muted="status == 'off'"/>
                            <field name="locked" widget="boolean"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="pm_generator_view_search" model="ir.ui.view">
        <field name="name">pm.generator.subscription.search</field>
        <field name="model">pm.generator.subscription</field>
        <field name="arch" type="xml">
            <search>
                <field name="unit_id"/>
                <field name="tenant_id"/>
                <filter name="on_plan" string="On the plan" domain="[('on_plan', '=', True)]"/>
                <filter name="off_plan" string="Not on the plan" domain="[('on_plan', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="pm_generator_action" model="ir.actions.act_window">
        <field name="name">Generator plan</field>
        <field name="res_model">pm.generator.subscription</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_on_plan': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nobody is on the generator plan yet.</p>
            <p>Tenants can switch it on in their portal, or click <b>New</b> to add one yourself.</p>
        </field>
    </record>

    <!-- ===== Make the month's service charge invoices ===== -->
    <record id="pm_service_invoice_wizard_view_form" model="ir.ui.view">
        <field name="name">pm.service.invoice.wizard.form</field>
        <field name="model">pm.service.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Create service charge invoices">
                <field name="state" invisible="1"/>
                <group invisible="state == 'done'">
                    <field name="building_id" options="{'no_create': True}"/>
                    <field name="month"/>
                </group>
                <p class="text-muted" invisible="state == 'done'">
                    One draft invoice per tenant: the fixed items, the water line and the generator line. Type the month's water costs first.
                </p>
                <group invisible="state != 'done'">
                    <field name="summary" nolabel="1" readonly="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_create" type="object" string="Create invoices" class="btn-primary" invisible="state == 'done'"/>
                    <button name="action_open_invoices" type="object" string="Open the invoices" class="btn-primary" invisible="state != 'done'"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="pm_service_invoice_wizard_action" model="ir.actions.act_window">
        <field name="name">Create service charge invoices</field>
        <field name="res_model">pm.service.invoice.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ===== Product form: the three flags ===== -->
    <record id="pm_product_template_form" model="ir.ui.view">
        <field name="name">product.template.form.property.management</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='detailed_type']" position="after">
                <field name="pm_is_water"/>
                <field name="pm_optional"/>
                <field name="pm_subscription"/>
            </xpath>
        </field>
    </record>
    <!-- ===== Water categories (the price tiers tenants are billed by) ===== -->
    <record id="pm_water_category_view_list" model="ir.ui.view">
        <field name="name">pm.water.category.list</field>
        <field name="model">pm.water.category</field>
        <field name="arch" type="xml">
            <tree string="Water categories">
                <field name="name"/>
                <field name="is_borehole" widget="boolean"/>
                <field name="sewerage_percent"/>
            </tree>
        </field>
    </record>

    <record id="pm_water_category_view_form" model="ir.ui.view">
        <field name="name">pm.water.category.form</field>
        <field name="model">pm.water.category</field>
        <field name="arch" type="xml">
            <form string="Water category">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <group>
                        <field name="name"/>
                        <field name="is_borehole"/>
                        <field name="sewerage_percent" invisible="is_borehole"/>
                    </group>
                    <notebook>
                        <page string="Water prices" invisible="is_borehole">
                            <field name="water_tier_ids" context="{'default_tier_type': 'water'}">
                                <tree editable="bottom">
                                    <field name="from_unit"/>
                                    <field name="to_unit"/>
                                    <field name="price_per_unit"/>
                                    <field name="tier_type" column_invisible="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Sewerage prices">
                            <field name="sewerage_tier_ids" context="{'default_tier_type': 'sewerage'}">
                                <tree editable="bottom">
                                    <field name="from_unit"/>
                                    <field name="to_unit"/>
                                    <field name="price_per_unit"/>
                                    <field name="tier_type" column_invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pm_water_category_action" model="ir.actions.act_window">
        <field name="name">Water categories</field>
        <field name="res_model">pm.water.category</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
