<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Repair charge: used when a tenant caused damage. The price is typed on each invoice. -->
    <record id="product_repair_charge" model="product.product">
        <field name="name">Repair charge</field>
        <field name="detailed_type">service</field>
        <field name="list_price">0</field>
        <field name="sale_ok" eval="True"/>
        <field name="purchase_ok" eval="False"/>
    </record>
</odoo>
