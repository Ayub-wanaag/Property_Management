<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pm_ticket_view_list" model="ir.ui.view">
        <field name="name">pm.ticket.list</field>
        <field name="model">pm.ticket</field>
        <field name="arch" type="xml">
            <tree string="Problems" decoration-danger="priority == 'urgent' and state in ('new', 'assigned', 'in_progress', 'waiting_approval')">
                <field name="create_date" string="Reported"/>
                <field name="unit_id"/>
                <field name="name"/>
                <field name="category"/>
                <field name="priority" widget="badge" decoration-danger="priority == 'urgent'" decoration-info="priority == 'normal'" decoration-muted="priority == 'low'"/>
                <field name="assigned_user_id"/>
                <field name="state" widget="badge" decoration-info="state in ('new', 'assigned')" decoration-warning="state in ('in_progress', 'waiting_approval')"
                       decoration-success="state in ('done', 'closed')"/>
            </tree>
        </field>
    </record>

    <record id="pm_ticket_view_form" model="ir.ui.view">
        <field name="name">pm.ticket.form</field>
        <field name="model">pm.ticket</field>
        <field name="arch" type="xml">
            <form string="Problem">
                <header>
                    <button name="action_assign" type="object" string="Assign" class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_start" type="object" string="Start work" class="btn-primary" invisible="state not in ('new', 'assigned')"/>
                    <button name="action_approve" type="object" string="Approve the repair" class="btn-primary"
                            invisible="state != 'waiting_approval'" groups="pm_property.group_pm_manager"
                            confirm="The work can start once you approve. Continue?"/>
                    <button name="action_done" type="object" string="Work is done" class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_charge_tenant" type="object" string="Charge the tenant"
                            invisible="state not in ('done', 'closed') or charged_to != 'tenant' or repair_invoice_id"
                            groups="pm_property.group_pm_accountant"
                            confirm="This makes a draft invoice to the tenant for what the repair really cost. Continue?"/>
                    <button name="action_close" type="object" string="Close" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,assigned,in_progress,done,closed"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="priority != 'urgent' or state in ('done', 'closed')">
                        Urgent. Phone the plumber, electrician or security now. Do not wait for the system.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="state != 'waiting_approval'">
                        The estimated cost is above the approval limit. Work starts after a manager approves.
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Kitchen tap is leaking"/></h1></div>
                    <group>
                        <group string="Where and what">
                            <field name="building_id" options="{'no_create': True}"/>
                            <field name="lease_id" options="{'no_create': True}"/>
                            <field name="unit_id" options="{'no_create': True}" placeholder="Empty = shared area"/>
                            <field name="category"/>
                            <field name="priority"/>
                            <field name="source"/>
                        </group>
                        <group string="Who and how much">
                            <field name="assigned_user_id" options="{'no_create': True}"/>
                            <field name="vendor_name"/>
                            <field name="estimated_cost" groups="pm_property.group_pm_accountant"/>
                            <field name="requires_approval" groups="pm_property.group_pm_accountant"/>
                            <field name="actual_cost" groups="pm_property.group_pm_accountant"/>
                            <field name="charged_to" groups="pm_property.group_pm_accountant"/>
                            <field name="repair_invoice_id" groups="pm_property.group_pm_accountant" invisible="not repair_invoice_id"/>
                            <field name="approved_by" invisible="not approved"/>
                            <field name="approved_on" invisible="not approved"/>
                            <field name="approved" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What happened, since when, where exactly"/>
                    <group string="Photos">
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="pm_ticket_view_search" model="ir.ui.view">
        <field name="name">pm.ticket.search</field>
        <field name="model">pm.ticket</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="unit_id"/>
                <field name="tenant_id"/>
                <filter name="open" string="Open" domain="[('state', 'in', ('new', 'assigned', 'in_progress', 'waiting_approval'))]"/>
                <filter name="urgent" string="Urgent" domain="[('priority', '=', 'urgent')]"/>
                <filter name="mine" string="Assigned to me" domain="[('assigned_user_id', '=', uid)]"/>
                <group expand="0" string="Group by">
                    <filter name="by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="by_building" string="Building" context="{'group_by': 'building_id'}"/>
                    <filter name="by_category" string="Kind of repair" context="{'group_by': 'category'}"/>
                    <filter name="by_payer" string="Who pays" context="{'group_by': 'charged_to'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="pm_ticket_action" model="ir.actions.act_window">
        <field name="name">Problems</field>
        <field name="res_model">pm.ticket</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No problems reported.</p>
            <p>Tenants report problems from their portal. You can also click <b>New</b> to log one.</p>
        </field>
    </record>

    <record id="pm_ticket_approval_action" model="ir.actions.act_window">
        <field name="name">Repairs waiting for approval</field>
        <field name="res_model">pm.ticket</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('state', '=', 'waiting_approval')]</field>
    </record>

    <record id="pm_ticket_urgent_action" model="ir.actions.act_window">
        <field name="name">Urgent problems</field>
        <field name="res_model">pm.ticket</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('priority', '=', 'urgent'), ('state', 'in', ('new', 'assigned', 'in_progress', 'waiting_approval'))]</field>
    </record>

    <record id="pm_ticket_mine_action" model="ir.actions.act_window">
        <field name="name">Problems assigned to me</field>
        <field name="res_model">pm.ticket</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('assigned_user_id', '=', uid), ('state', 'in', ('new', 'assigned', 'in_progress', 'waiting_approval'))]</field>
    </record>
</odoo>
