<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pm_lease_view_list" model="ir.ui.view">
        <field name="name">pm.lease.list</field>
        <field name="model">pm.lease</field>
        <field name="arch" type="xml">
            <tree string="Leases" delete="false">
                <field name="unit_id"/>
                <field name="tenant_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="rent_amount"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'notice'"
                       decoration-info="state == 'draft'"/>
            </tree>
        </field>
    </record>

    <record id="pm_lease_view_form" model="ir.ui.view">
        <field name="name">pm.lease.form</field>
        <field name="model">pm.lease</field>
        <field name="arch" type="xml">
            <form string="Lease" delete="false">
                <header>
                    <button name="action_start" type="object" string="Start lease" class="btn-primary"
                            invisible="state != 'draft'"
                            confirm="This will mark the unit as occupied. Continue?"/>
                    <button name="action_open_login_wizard" type="object" string="Create tenant login" class="btn-primary"
                            invisible="state not in ('active', 'notice')"/>
                    <button name="action_give_notice" type="object" string="Give notice"
                            invisible="state != 'active'"
                            confirm="This will mark the unit as 'Notice given'. Continue?"/>
                    <button name="action_end" type="object" string="End lease"
                            invisible="state not in ('active', 'notice')"
                            confirm="This will mark the unit as vacant and turn off the tenant's login. Continue?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_deposits" type="object" class="oe_stat_button" icon="fa-lock"
                                groups="pm_property.group_pm_accountant">
                            <field name="deposit_count" widget="statinfo" string="Deposit"/>
                        </button>
                        <button name="action_open_inspections" type="object" class="oe_stat_button" icon="fa-camera">
                            <field name="inspection_count" widget="statinfo" string="Inspections"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Who and where">
                            <field name="unit_id"/>
                            <field name="tenant_id"/>
                            <field name="tenant_login" invisible="not tenant_login"/>
                        </group>
                        <group string="Dates">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="notice_days"/>
                        </group>
                    </group>
                    <group string="Money">
                        <group>
                            <field name="rent_amount"/>
                            <field name="rent_due_day"/>
                        </group>
                        <group>
                            <field name="deposit_amount"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="pm_lease_view_search" model="ir.ui.view">
        <field name="name">pm.lease.search</field>
        <field name="model">pm.lease</field>
        <field name="arch" type="xml">
            <search string="Search leases">
                <field name="name" string="Unit or tenant"/>
                <field name="building_id"/>
                <filter name="filter_active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="filter_notice" string="Notice given" domain="[('state', '=', 'notice')]"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_ended" string="Ended" domain="[('state', '=', 'ended')]"/>
                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group by">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_building" string="Building" context="{'group_by': 'building_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="pm_lease_action" model="ir.actions.act_window">
        <field name="name">Leases</field>
        <field name="res_model">pm.lease</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No leases yet. Click <b>New</b> to move a tenant into a unit.</p>
        </field>
    </record>
</odoo>
