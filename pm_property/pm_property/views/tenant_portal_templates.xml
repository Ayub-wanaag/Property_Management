<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_tenant" name="My house card" inherit_id="portal.portal_my_home">
        <xpath expr="//div[@id='portal_common_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">My house</t>
                <t t-set="text">Your rent, payments and lease</t>
                <t t-set="url" t-value="'/my/tenant'"/>
                <t t-set="icon" t-value="'/pm_property/static/img/house.svg'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>

    <template id="portal_my_security_logout" inherit_id="portal.portal_my_security" name="Log out on Connection and Security">
        <xpath expr="//section[@name='portal_revoke_all_devices_popup']" position="after">
            <section name="pm_logout" class="mt-4">
                <h4>Log out</h4>
                <a href="/web/session/logout?redirect=/" class="btn btn-secondary">Log out</a>
            </section>
        </xpath>
    </template>

    <template id="tenant_no_lease" name="Tenant: no lease">
        <t t-call="portal.portal_layout">
            <t t-set="no_breadcrumbs" t-value="1"/>
            <t t-set="additional_title">My house</t>
            <div class="container py-4 pm-portal">
                <div class="alert alert-info" role="alert">
                    We could not find an active lease for you. Please ask the office for help.
                </div>
            </div>
        </t>
    </template>

    <template id="tenant_home_page" name="Tenant home">
        <t t-call="portal.portal_layout">
            <t t-set="no_breadcrumbs" t-value="1"/>
            <t t-set="additional_title">My house</t>
            <div class="container py-4 pm-portal">
                <h1 class="h3 mb-1" t-out="lease.unit_id.display_name"/>
                <p class="text-muted mb-4">Welcome, <t t-out="lease.tenant_id.name"/></p>

                <!-- 1. The facts -->
                <div class="card mb-3">
                    <div class="card-body fs-5">
                        <div class="pm-row d-flex justify-content-between align-items-baseline">
                            <span class="text-muted">Monthly rent</span>
                            <strong t-out="lease.rent_amount" t-options='{"widget": "monetary", "display_currency": currency}'/>
                        </div>
                        <div class="pm-row d-flex justify-content-between align-items-baseline">
                            <span class="text-muted">Rent is due on day</span>
                            <strong t-out="lease.rent_due_day"/>
                        </div>
                        <div class="pm-row d-flex justify-content-between align-items-baseline">
                            <span class="text-muted">Lease started</span>
                            <strong t-out="lease.start_date" t-options='{"widget": "date"}'/>
                        </div>
                    </div>
                </div>

                <div id="pm_home_money"/>

                <div class="row row-cols-2 g-2 mb-4" id="pm_home_grid">
                    <div class="col"><a href="/my/tenant/documents" class="btn btn-outline-secondary w-100 h-100 py-3 d-flex align-items-center justify-content-center text-center fw-semibold">Documents</a></div>
                    <div class="col"><a href="/my/tenant/move-out" class="btn btn-outline-secondary w-100 h-100 py-3 d-flex align-items-center justify-content-center text-center fw-semibold">Move out</a></div>
                    <div class="col"><a href="/my/tenant/help" class="btn btn-outline-secondary w-100 h-100 py-3 d-flex align-items-center justify-content-center text-center fw-semibold">Help and contacts</a></div>
                </div>

                <div id="pm_home_extra"/>

                <!-- 5. Password, security and log out live on one page -->
                <a href="/my/security" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center rounded-3 border mb-3">
                    <span>Connection &amp; Security</span><i class="fa fa-angle-right text-muted"/>
                </a>
            </div>
        </t>
    </template>
</odoo>
