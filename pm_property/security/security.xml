<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_property_management" model="ir.module.category">
        <field name="name">Property Management</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_pm_caretaker" model="res.groups">
        <field name="name">Caretaker</field>
        <field name="category_id" ref="module_category_property_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Meter readings, chase list and assigned problems. Sees no money totals and no owner statements.</field>
    </record>

    <record id="group_pm_accountant" model="res.groups">
        <field name="name">Accountant</field>
        <field name="category_id" ref="module_category_property_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('account.group_account_invoice'))]"/>
        <field name="comment">Invoices, payments, expenses and statements.</field>
    </record>

    <record id="group_pm_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_property_management"/>
        <field name="implied_ids" eval="[(4, ref('group_pm_caretaker')), (4, ref('group_pm_accountant')), (4, ref('base.group_partner_manager'))]"/>
        <field name="comment">Everything operational. Includes the Caretaker and Accountant roles.</field>
    </record>

    <record id="group_pm_owner" model="res.groups">
        <field name="name">Owner</field>
        <field name="category_id" ref="module_category_property_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Read-only view of their own buildings.</field>
    </record>

    <!-- Staff see every building and owner -->
    <record id="pm_building_rule_staff" model="ir.rule">
        <field name="name">Building: staff see all buildings</field>
        <field name="model_id" ref="model_pm_building"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pm_caretaker')), (4, ref('group_pm_accountant')), (4, ref('group_pm_manager'))]"/>
    </record>

    <record id="pm_owner_rule_staff" model="ir.rule">
        <field name="name">Owner: staff see all owners</field>
        <field name="model_id" ref="model_pm_owner"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pm_caretaker')), (4, ref('group_pm_accountant')), (4, ref('group_pm_manager'))]"/>
    </record>

    <!-- Owners only see their own buildings and their own record -->
    <record id="pm_building_rule_owner" model="ir.rule">
        <field name="name">Building: owners see only their buildings</field>
        <field name="model_id" ref="model_pm_building"/>
        <field name="domain_force">[('owner_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_pm_owner'))]"/>
    </record>

    <record id="pm_owner_rule_owner" model="ir.rule">
        <field name="name">Owner: owners see only their own record</field>
        <field name="model_id" ref="model_pm_owner"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_pm_owner'))]"/>
    </record>

    <!-- Units: staff see all, owners only units in their own buildings -->
    <record id="pm_unit_rule_staff" model="ir.rule">
        <field name="name">Unit: staff see all units</field>
        <field name="model_id" ref="model_pm_unit"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pm_caretaker')), (4, ref('group_pm_accountant')), (4, ref('group_pm_manager'))]"/>
    </record>

    <record id="pm_unit_rule_owner" model="ir.rule">
        <field name="name">Unit: owners see only units in their buildings</field>
        <field name="model_id" ref="model_pm_unit"/>
        <field name="domain_force">[('building_id.owner_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_pm_owner'))]"/>
    </record>

    <!-- Documents: managers all; other staff all but the managers-only ones; owners only what is shared with them -->
    <record id="pm_document_rule_manager" model="ir.rule">
        <field name="name">Document: managers see all documents</field>
        <field name="model_id" ref="model_pm_document"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pm_manager'))]"/>
    </record>

    <record id="pm_document_rule_staff" model="ir.rule">
        <field name="name">Document: other staff do not see managers-only documents</field>
        <field name="model_id" ref="model_pm_document"/>
        <field name="domain_force">[('visibility', '!=', 'managers')]</field>
        <field name="groups" eval="[(4, ref('group_pm_caretaker')), (4, ref('group_pm_accountant'))]"/>
    </record>

    <record id="pm_document_rule_owner" model="ir.rule">
        <field name="name">Document: owners see only what is shared with them</field>
        <field name="model_id" ref="model_pm_document"/>
        <field name="domain_force">[('visible_to_owner', '=', True), ('building_id.owner_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_pm_owner'))]"/>
    </record>
</odoo>
