<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_property" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.property</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Property" string="Property" name="pm_property">
                    <block title="Defaults for new buildings and leases" name="pm_property_defaults">
                        <setting string="Deposit refund days" help="Used for new buildings. Existing buildings keep their own value.">
                            <field name="pm_deposit_refund_days"/>
                        </setting>
                        <setting string="Biggest photo (MB)" help="Used for new buildings. Existing buildings keep their own value.">
                            <field name="pm_max_photo_mb"/>
                        </setting>
                        <setting string="Notice days" help="Used for new leases. Existing leases keep their own value.">
                            <field name="pm_notice_days"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
