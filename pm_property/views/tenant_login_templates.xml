<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="tenant_login_page" name="Tenant sign in">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container py-5" style="max-width: 480px;">
                    <h1 class="mb-1">Tenant portal</h1>
                    <p class="text-muted mb-4">Sign in with your name, your building and your password.</p>
                    <div t-if="error" class="alert alert-danger" role="alert">
                        <t t-out="error"/>
                    </div>
                    <form method="post" action="/tenant/login">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="mb-3">
                            <label for="tenant_name" class="form-label">Your name</label>
                            <input type="text" name="tenant_name" id="tenant_name" t-att-value="tenant_name"
                                   class="form-control form-control-lg" placeholder="Example: Amina Otieno"
                                   required="required" autocomplete="name"/>
                        </div>
                        <div class="mb-3">
                            <label for="building" class="form-label">Your building</label>
                            <input type="text" name="building" id="building" t-att-value="building"
                                   class="form-control form-control-lg" placeholder="Example: Sunrise Apartments"
                                   required="required" autocomplete="off"/>
                        </div>
                        <div class="mb-4">
                            <label for="password" class="form-label">Your password</label>
                            <input type="password" name="password" id="password"
                                   class="form-control form-control-lg" required="required"
                                   autocomplete="current-password"/>
                        </div>
                        <button type="submit" class="btn btn-lg w-100 pm-btn-primary">Sign in</button>
                    </form>
                    <p class="text-center mt-4"><a href="/">&#8592; Back to start</a></p>
                </div>
            </div>
        </t>
    </template>
</odoo>
