<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_welcome_sheet" model="ir.actions.report">
        <field name="name">Welcome sheet</field>
        <field name="model">pm.lease.login.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">property_management.report_welcome_sheet</field>
        <field name="report_file">property_management.report_welcome_sheet</field>
        <field name="print_report_name">'Welcome sheet - %s' % (object.tenant_name or '')</field>
    </record>

    <template id="report_welcome_sheet">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-size: 20px; line-height: 1.6;">
                        <h1 style="font-size: 36px;">Welcome, <t t-out="o.tenant_name"/></h1>
                        <p>Your house: <strong><t t-out="o.house"/></strong></p>
                        <h2 style="font-size: 28px; margin-top: 30px;">How to sign in</h2>
                        <p>1. Open this address on your phone:<br/>
                            <strong><t t-out="o.login_url"/></strong></p>
                        <p>2. Type your name, your building and your password.</p>
                        <p style="margin-top: 30px;">Your name: <strong><t t-out="o.tenant_name"/></strong></p>
                        <p>Your building: <strong><t t-out="o.lease_id.building_id.name"/></strong></p>
                        <p>Your password: <strong style="font-size: 30px;"><t t-out="o.password"/></strong></p>
                        <p style="margin-top: 40px;">Please keep this paper in a safe place.</p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
